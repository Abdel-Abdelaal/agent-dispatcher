# Copy to .env for local runs. Never commit .env.
# Optional: a `claude setup-token` token. Without it, the CLI uses its own login.
DISPATCHER_CLAUDE_OAUTH_TOKEN=
# Thinking = plan and review; work = implementing when no worker is left.
DISPATCHER_CLAUDE_THINK_EFFORT=high
DISPATCHER_CLAUDE_THINK_MODEL=claude-opus-5-5
DISPATCHER_CLAUDE_WORK_EFFORT=medium
DISPATCHER_CLAUDE_WORK_MODEL=claude-sonnet-5-5
DISPATCHER_CODEX_THINK_EFFORT=high
DISPATCHER_CODEX_THINK_MODEL=gpt-6.1-sol
DISPATCHER_CODEX_WORK_EFFORT=medium
DISPATCHER_CODEX_WORK_MODEL=gpt-6.1-sol
DISPATCHER_DB_PATH=dispatcher.sqlite3
# Optional: only raises the GitHub API rate limit for polling.
DISPATCHER_GITHUB_TOKEN=
DISPATCHER_MAX_FILES=15
DISPATCHER_MAX_LINES=400
DISPATCHER_MAX_WEEKLY_SHARE=0.6
# Triage and advisory review providers.
DISPATCHER_MIMO_API_KEY=
DISPATCHER_NVIDIA_API_KEY=
DISPATCHER_OWNER=Abdel-Abdelaal
DISPATCHER_PARK_HOURS=5
# Comma-separated owner/name list.
DISPATCHER_REPOS=Abdel-Abdelaal/shortlink
DISPATCHER_WORK_ROOT=runs
